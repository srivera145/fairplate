APP_NAME="Keel App"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://keel.local
APP_REPO_URL=
APP_LICENSE=TODO
MULTI_TENANCY_ENABLED=false
FILESYSTEM_DISK=local
FILESYSTEM_MAX_UPLOAD_MB=10
FILESYSTEM_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,heic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Maps platform key, used for two things: the Routes API for driving
# distance (restaurant to customer, which every driver payout is priced on) and
# the Geocoding API for turning a typed address into lat/lng. Enable both APIs
# on the key. Left empty, routing falls back to straight-line distance and
# geocoding refuses outright.
GOOGLE_MAPS_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=keel
DB_USERNAME=root
DB_PASSWORD=

# otp | magic_link | both
AUTH_METHOD=both

# SMS delivery for FairPlate's phone OTP sign-in.
# log: write outgoing texts to storage/logs/sms.log (read the code back from there).
# No real provider is wired yet; add one branch to Keel\Core\Sms when you pick one.
SMS_DRIVER=log

# Mail configuration
# smtp | log
# - smtp (default): real email delivery via configured SMTP provider.
# - log: write outgoing mail to storage/logs/mail.log (useful for local dev before SMTP is set up).
#   In log mode, request an OTP or magic link and read the code/URL from that file.
MAIL_MAILER=smtp

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Keel App"
